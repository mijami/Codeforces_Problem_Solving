#include <bits/stdc++.h>
 
using namespace std;
 
int main()
{
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    cout.tie(0);
 
    int n;
    int flag=0;
    cin >> n;
    int a[n], b[n];
    for(int i=0; i<n; i++){
        cin >> a[i] >> b[i];
        if(abs(a[i]-b[i]) > 0){
            flag++;
        }
    }
 
    if(flag){
        cout << "rated" << "
";
    }
 
    else{
        int k=0;
 
            for(int i=0;i<n-1;i++){
                for(int j=i+1; j<n; j++){
                    if(a[j]>a[i]){
                        k++;
                    }
                }
            }
        if(k){
            cout << "unrated" << "
";
        }
        else{
            cout << "maybe" << "
";
        }
 
    }
 
    return 0;
}