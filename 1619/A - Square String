#include <bits/stdc++.h>
 
using namespace std;
 
int main()
{
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    cout.tie(0);
 
    int n;
    cin >> n;
    string a;
    while(n--){
        cin >> a;
        int s = a.size();
        if(s%2 != 0){
            cout << "NO" << "
";
        }
        else{
            int h=s/2, c=0;
            for(int i=0; i<h; i++){
                if(a[i]==a[h+i]){
                    c++;
                }
 
            }
            if(h==c){
                cout << "YES" << "
";
            }
            else{
                cout << "NO" << "
";
            }
        }
    }
    return 0;
}