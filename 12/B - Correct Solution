#include <bits/stdc++.h>
 
using namespace std;
 
int main()
{
    ios_base::sync_with_stdio(0);
    cin.tie(0);
 
    string a,b;
    cin >> a >> b;
    int lenA= a.length();
    int lenB= b.length();
 
    sort(a.begin(), a.end());
 
    if(a[0]=='0'){
        for(int i=0; i<lenA; i++){
            if(a[i]!='0'){
                swap(a[i], a[0]);
                break;
            }
        }
    }
    if(lenA != lenB)
    {
        cout << "WRONG_ANSWER" << "
";
        return 0;
    }
    for(int i=0; i<lenA; i++)
    {
        if(a[i]!=b[i])
        {
            cout << "WRONG_ANSWER" << "
";
            return 0;
        }
    }
    cout << "OK" << "
";
    return 0;
}